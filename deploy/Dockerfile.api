FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/backend
WORKDIR /app
COPY backend/requirements.txt backend/requirements.txt
RUN pip install --no-cache-dir -r backend/requirements.txt
COPY backend backend
COPY contracts contracts
RUN useradd --uid 10001 --create-home prepcrew && mkdir /app/.artifacts && chown prepcrew:prepcrew /app/.artifacts
USER prepcrew
EXPOSE 8000
# A single process owns the in-process background workers. Scale only after
# validating worker claiming, pair sockets and recovery across replicas.
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*"]
