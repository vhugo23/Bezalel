FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/backend
WORKDIR /app
COPY backend/requirements.txt backend/requirements.txt
RUN pip install --no-cache-dir -r backend/requirements.txt
COPY backend backend
COPY contracts contracts
COPY deploy/render_start.py deploy/render_start.py
RUN useradd --uid 10001 --create-home prepcrew && mkdir /app/.artifacts
# Root initializes ownership of the mounted disk, then permanently drops to
# prepcrew before replacing itself with uvicorn. Never chown uploaded files.
CMD ["python", "deploy/render_start.py"]
