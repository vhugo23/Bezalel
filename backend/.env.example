# Database (Tiger Data / any Postgres). Leave blank to run on in-memory data.
DATABASE_URL=

# Provider keys (fill in only the ones you use)
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
BACKBOARD_API_KEY=

# Which provider each core service uses. "fake" works with no keys.
LLM_PROVIDER=fake
VOICE_PROVIDER=fake
# memory | postgres | backboard. Blank = postgres if DATABASE_URL is set, else memory
MEMORY_BACKEND=
# Set MEMORY_BACKEND=backboard to keep candidate memory in Backboard (falls back to the database on errors)

TASK_TIMEOUT_SECONDS=20

# ---- Interview voice loop (all optional, defaults live in app/config.py)
# Gemini model for plans, replies and the gap check. A lite model was about 1 s per call, gemini-3.8-flash was 3 to 28 s.
GEMINI_MODEL=
ELEVENLABS_VOICE_ID=          # a voice your plan can use through the API (library voices need a paid plan)
ELEVENLABS_MODEL=             # for example eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=pcm_16000
ELEVENLABS_STT_MODEL=scribe_v2
# Voice settings, blank = the voice's own. Tune by ear with spikes/ab_voice.py
ELEVENLABS_STABILITY=
ELEVENLABS_SIMILARITY=
ELEVENLABS_STYLE=
ELEVENLABS_SPEED=
LIVE_TURN_TIMEOUT_SECONDS=5     # a live reply waits this long for the model, then asks the planned question
STT_TIMEOUT_SECONDS=15
ASSESSOR_TIMEOUT_SECONDS=4      # the gap check that feeds the patience meter

# ---- Patience meter (hand-picked starting values, not validated)
FAIL_THRESHOLD=1.0
WRAP_UP_AT=0.5
PENALTY_REQUIRED_UNKNOWN=0.6
PENALTY_REQUIRED_PARTIAL=0.25
PENALTY_PREFERRED_UNKNOWN=0.15
PENALTY_PREFERRED_PARTIAL=0.05
PENALTY_NON_ANSWER=0.35
MAX_PENALTY_PER_ANSWER=0.6

