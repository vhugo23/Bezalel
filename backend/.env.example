# npm start manages native Postgres and uses per-account Connections.
# No provider keys or .env file are required for that launcher.
# These are examples for direct API development, not production credentials.
DATABASE_URL=postgresql://prepcrew:prepcrew_local@127.0.0.1:15432/prepcrew
V2_DATABASE_SCHEMA=prepcrew
DATABASE_TIMESCALE=false
MEMORY_BACKEND=postgres
LEGACY_API_ENABLED=false
PREPCREW_BYOB_ONLY=true
DEMO_MODE=false
# Hosted launcher: set process environment, persistent storage and HTTPS origin.
# PREPCREW_PUBLIC=true
# PUBLIC_BASE_URL=https://your-host.example
# PREPCREW_DATA_DIR=/persistent/prepcrew
# PREPCREW_ENCRYPTION_KEY=<externally-managed-fernet-key>
# PREPCREW_PROVIDER_HOSTS=approved-model-host.example
