# Public configuration only. Never put provider keys in VITE_* variables.
VITE_API_URL=
# Split Vercel/Render deployment: Render HTTPS origin for direct ticket-authenticated
# sockets. Keep blank for local development or a single-origin deployment.
VITE_WS_URL=
# Optional origin reachable by the paired device, e.g. https://prepcrew.example.
# The pairing dialog can override this address without rebuilding.
VITE_PAIR_ORIGIN=
# DEMO_MODE belongs to the server .env, never the browser.
